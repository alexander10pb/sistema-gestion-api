MONGO_URI=mongodb://localhost:27017
DB_NAME=cafeteria_db

# Obligatoria: la app no arranca sin una clave propia.
# Genera una con: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Credenciales de Cloudinary para las imágenes
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Orígenes permitidos por CORS, separados por comas.
# Si se omite, se usan los orígenes por defecto definidos en main.py
ALLOWED_ORIGINS=http://localhost:3000
